{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "marcador-de-treino",
  "main": "src/worker/index.ts",
  "compatibility_date": "2025-09-01",
  "assets": {
    // Com @cloudflare/vite-plugin o diretório (dist/client) é resolvido no build.
    "not_found_handling": "single-page-application",
    // Rotas /api/* sempre passam pelo Worker.
    "run_worker_first": ["/api/*"]
  },
  "vars": {
    "ACCESS_TEAM_DOMAIN": "",
    "ACCESS_AUD": "",
    "OWNER_EMAIL": ""
  }
  // Fase 2: adicionar "d1_databases" com o binding DB e o database_id.
}
