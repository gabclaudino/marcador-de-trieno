{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "marcador-de-treino",
  "main": "src/worker/index.ts",
  "compatibility_date": "2025-09-01",
  "assets": {
    // Com @cloudflare/vite-plugin o diretório (dist/client) é resolvido no build.
    "not_found_handling": "single-page-application",
    // Rotas /api/* sempre passam pelo Worker.
    "run_worker_first": ["/api/*"]
  },
  "vars": {
    "ACCESS_TEAM_DOMAIN": "",
    "ACCESS_AUD": "",
    "OWNER_EMAIL": ""
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "treino-db",
      // Placeholder: serve para dev local. Na Fase 10, rodar `wrangler d1 create treino-db`
      // e colocar aqui o database_id real.
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "migrations"
    }
  ]
}
