{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "marcador-de-treino",
  "main": "src/worker/index.ts",
  "compatibility_date": "2025-09-01",
  "assets": {
    // Com @cloudflare/vite-plugin o diretório (dist/client) é resolvido no build.
    "not_found_handling": "single-page-application",
    // Rotas /api/* sempre passam pelo Worker.
    "run_worker_first": ["/api/*"]
  },
  // Só o custom domain (protegido pelo Cloudflare Access) deve responder.
  // workers.dev e URLs de preview ficariam fora do Access.
  "workers_dev": false,
  "preview_urls": false,
  // Segredos (NÃO ficam neste arquivo, para não versionar e-mail/IDs):
  //   wrangler secret put ACCESS_TEAM_DOMAIN   (ex.: meutime.cloudflareaccess.com)
  //   wrangler secret put ACCESS_AUD           (AUD tag da Access application)
  //   wrangler secret put OWNER_EMAIL          (seu e-mail)
  // Veja DEPLOY.md. Em dev local usa-se DEV_BYPASS_AUTH no .dev.vars.
  "routes": [{ "pattern": "treino.gabizao.dev", "custom_domain": true }],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "treino-db",
      "database_id": "34ada5ef-2c67-4e5f-8107-771f1dbbba1a",
      "migrations_dir": "migrations"
    }
  ]
}
